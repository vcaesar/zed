# Release image built by goreleaser (dockers_v2): the binary is prebuilt per
# platform and copied from $TARGETPLATFORM/zedsearch in the build context.
FROM alpine:3.22 AS base
RUN apk add --no-cache ca-certificates \
    && addgroup -g 10001 zedsearch \
    && adduser -D -H -h /nonexistent -s /sbin/nologin -u 10001 -G zedsearch zedsearch \
    && mkdir -p /var/lib/zedsearch /data \
    && chown zedsearch:zedsearch /var/lib/zedsearch /data

FROM scratch
ARG TARGETPLATFORM
COPY --from=base /etc/passwd /etc/passwd
COPY --from=base /etc/group /etc/group
COPY --from=base /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=base --chown=zedsearch:zedsearch /var/lib/zedsearch /var/lib/zedsearch
COPY --from=base --chown=zedsearch:zedsearch /data /data
COPY $TARGETPLATFORM/zedsearch /go/bin/zedsearch
USER zedsearch:zedsearch
EXPOSE 4080
ENTRYPOINT ["/go/bin/zedsearch"]
